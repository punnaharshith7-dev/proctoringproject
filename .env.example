# Copy this file to .env locally and replace placeholder values. Never commit .env.
SECRET_KEY=replace-with-a-long-random-secret

# Google OAuth: create a Web application client in Google Cloud.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Local authorized JavaScript origin: http://127.0.0.1:5000
# Local authorized redirect URI: http://127.0.0.1:5000/auth/google/callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

# Email password-reset OTP. Use your mail provider's SMTP details; for Gmail,
# use an App Password, not your normal Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-email-app-password
MAIL_FROM=your-email@example.com

# Production must use HTTPS and match the Google Cloud redirect URI exactly.
# GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback
